[
  {
    "name": "Initial JS (search-first shell)",
    "path": "dist/assets/index-*.js",
    "limit": "90 kB",
    "gzip": true
  },
  {
    "name": "Map chunk (MapLibre 6 is ~286 kB of it; lazy-loaded after first paint)",
    "path": "dist/assets/MapView-*.js",
    "limit": "310 kB",
    "gzip": true
  },
  {
    "name": "Sheet chunk (Motion drag features are ~30 kB of it; loads after the map)",
    "path": "dist/assets/PeopleSheet-*.js",
    "limit": "50 kB",
    "gzip": true
  },
  {
    "name": "CSS (MapLibre's stylesheet is ~11 kB of it)",
    "path": "dist/assets/*.css",
    "limit": "18 kB",
    "gzip": true
  },
  {
    "name": "Typeface (Plus Jakarta Sans, latin WOFF2)",
    "path": "dist/fonts/*.woff2",
    "limit": "30 kB",
    "gzip": false,
    "brotli": false
  }
]
